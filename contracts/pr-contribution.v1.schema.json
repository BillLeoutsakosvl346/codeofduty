{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeofduty.local/contracts/pr-contribution.v1.schema.json",
  "title": "Code of Duty PR Contribution Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "features", "impact", "contributors", "summary"],
  "properties": {
    "schema_version": { "const": "pr-contribution/v1" },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }
    },
    "impact": { "enum": ["patch", "feature", "foundation"] },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contributor_id", "share_bps", "roles"],
        "properties": {
          "contributor_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}$" },
          "share_bps": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": { "enum": ["architecture", "implementation", "product", "review", "testing"] }
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 12, "maxLength": 280 }
  }
}
