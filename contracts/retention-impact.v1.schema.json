{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeofduty.local/contracts/retention-impact.v1.schema.json",
  "title": "Retention Impact Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "impact"],
  "properties": {
    "schema_version": { "const": "retention-impact/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "impact": { "$ref": "#/$defs/retentionImpact" }
  },
  "$defs": {
    "featureId": {
      "type": "string",
      "enum": ["search", "summary", "sharing"]
    },
    "featureImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "adopter_count",
        "adopter_renewed_count",
        "non_adopter_count",
        "non_adopter_renewed_count",
        "renewal_rate_with_feature",
        "renewal_rate_without_feature",
        "observed_retention_lift",
        "positive_influence_score",
        "normalized_weight",
        "retained_revenue_impact_cents",
        "rank",
        "evidence",
        "reasoning",
        "confidence"
      ],
      "properties": {
        "feature_id": { "$ref": "#/$defs/featureId" },
        "adopter_count": { "type": "integer", "minimum": 1 },
        "adopter_renewed_count": { "type": "integer", "minimum": 0 },
        "non_adopter_count": { "type": "integer", "minimum": 1 },
        "non_adopter_renewed_count": {
          "type": "integer",
          "minimum": 0
        },
        "renewal_rate_with_feature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "renewal_rate_without_feature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "observed_retention_lift": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "positive_influence_score": { "type": "number", "minimum": 0 },
        "normalized_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retained_revenue_impact_cents": {
          "type": "integer",
          "minimum": 0
        },
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "reasoning": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "retentionImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "customer_count",
        "renewed_customer_count",
        "total_retained_revenue_cents",
        "currency",
        "methodology",
        "causality_notice",
        "features",
        "unattributed_retained_revenue_cents"
      ],
      "properties": {
        "cohort_id": { "type": "string", "minLength": 1 },
        "customer_count": { "type": "integer", "minimum": 1 },
        "renewed_customer_count": { "type": "integer", "minimum": 0 },
        "total_retained_revenue_cents": {
          "type": "integer",
          "minimum": 0
        },
        "currency": { "const": "usd" },
        "methodology": { "const": "observed-retention-lift-v1" },
        "causality_notice": {
          "const": "Observed cohort correlation; not causal attribution."
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/featureImpact" }
        },
        "unattributed_retained_revenue_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
