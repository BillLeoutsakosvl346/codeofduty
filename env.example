# Code of Duty Milestone 1 — local demo only.
# Copy to .env.local. Never commit test keys or webhook secrets.

# Browser + API
APP_URL=http://localhost:5173
API_PORT=3001
DATABASE_PATH=.data/codeofduty.sqlite
DEMO_USER_ID=demo_user_123

# PostHog browser capture. Use the exact host from your PostHog project.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Stripe sandbox/test mode. STRIPE_SECRET_KEY is optional when the local
# Stripe CLI is authenticated; the app can read that CLI test key at runtime.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional attribution model. Without this key, the app uses and labels the
# deterministic unique-session baseline so the full local flow remains usable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
