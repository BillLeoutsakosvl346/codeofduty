# ============================================================
# Code of Duty — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# On Vercel, set this to your deployed URL instead:
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app


# ------------------------------------------------------------
# Database — Neon / Postgres
# REQUIRED
# ------------------------------------------------------------

DATABASE_URL=


# ------------------------------------------------------------
# GitHub
# REQUIRED for PR ingestion
# ------------------------------------------------------------

# Fine-grained GitHub token with read access to:
# - Metadata
# - Contents
# - Pull requests
GITHUB_TOKEN=

# Repository owner / organization name
GITHUB_OWNER=

# Repository name
GITHUB_REPO=


# ------------------------------------------------------------
# Greptile
# REQUIRED for PR → feature contribution analysis
# ------------------------------------------------------------

GREPTILE_API_KEY=


# ------------------------------------------------------------
# PostHog
# REQUIRED for feature usage tracking
# ------------------------------------------------------------

# Safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=

# Use the exact host shown by PostHog / its setup wizard.
NEXT_PUBLIC_POSTHOG_HOST=


# ------------------------------------------------------------
# PostHog Server-side API
# OPTIONAL
#
# Only needed if our backend directly queries PostHog.
# For the hackathon MVP, we can mirror important events into
# Postgres and avoid depending on server-side PostHog queries.
# ------------------------------------------------------------

POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=


# ------------------------------------------------------------
# Stripe
# REQUIRED for live revenue demo
# USE TEST / SANDBOX KEYS ONLY
# ------------------------------------------------------------

# Server only. Never expose this in client-side code.
STRIPE_SECRET_KEY=

# Safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe test-mode Price ID, e.g. price_...
STRIPE_PRICE_ID=

# Webhook signing secret, e.g. whsec_...
#
# Locally:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
#
# The Stripe CLI will print a webhook signing secret.
#
# Vercel may use a DIFFERENT webhook secret from local development.
STRIPE_WEBHOOK_SECRET=


# ------------------------------------------------------------
# Demo / Development
# OPTIONAL
# ------------------------------------------------------------

# Allows the UI/API to fall back to seeded fixture data.
DEMO_MODE=true

# Optional user ID used for the hackathon demo flow.
DEMO_USER_ID=demo_user_123
